#!/bin/sh

# Gradle wrapper fallback for CI / local builds.
# To generate the full wrapper (gradle-wrapper.jar), run:
#   gradle wrapper --gradle-version 8.7
# This script delegates to the system Gradle when the full wrapper is not present.
set -e

GRADLE="${GRADLE_BIN:-gradle}"

if command -v "$GRADLE" >/dev/null 2>&1; then
    exec "$GRADLE" "$@"
else
    echo "ERROR: Gradle not found. Install Gradle 8.7 or run 'gradle wrapper' to generate the full wrapper." >&2
    exit 1
fi
